# ── Jupyter ──────────────────────────────────────────────────────────────
.ipynb_checkpoints/
*.ipynb_checkpoints

# ── Python ────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg-info/
dist/
build/
*.egg

# ── Virtual environments ──────────────────────────────────────────────────
venv/
.venv/
env/
.env/

# ── Data files ────────────────────────────────────────────────────────────
# Raw source data — do not commit large CSVs to Git
data/raw/*.csv
data/raw/*.xlsx
data/raw/*.parquet

# Processed/output data — regenerated by running the notebooks
data/processed/*.csv
data/processed/*.xlsx
data/processed/*.parquet

# ── OS and editor noise ───────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.swp
*.swo

# ── Secrets / credentials ─────────────────────────────────────────────────
.env
*.env
secrets.json
